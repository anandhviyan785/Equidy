{
  "name": "equidy",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Equidy — AI-powered financial intelligence platform",
  "scripts": {
    "dev": "EQUIDY_DEV_ACCOUNTS=1 concurrently -k -n web,api -c green,gray \"vite\" \"tsx watch server/index.ts\"",
    "dev:web": "vite",
    "dev:api": "tsx watch server/index.ts",
    "build": "vite build",
    "build:single": "vite build --mode single",
    "start": "NODE_ENV=production tsx server/index.ts",
    "typecheck": "tsc -p . --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@clerk/backend": "3.27.0",
    "@clerk/clerk-react": "5.61.12",
    "@neondatabase/serverless": "^0.10.4",
    "@pinecone-database/pinecone": "9.2.0",
    "@sentry/node": "11.11.0",
    "@sentry/react": "11.11.0",
    "@upstash/redis": "1.41.0",
    "arctic": "^3.6.0",
    "clsx": "^2.1.1",
    "express": "^4.21.1",
    "lucide-react": "^0.460.0",
    "pg": "8.23.1",
    "posthog-js": "1.447.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^9.0.1",
    "react-router-dom": "^6.28.0",
    "recharts": "^2.13.3",
    "remark-gfm": "^4.0.0",
    "stripe": "23.1.0",
    "tsx": "^4.19.2",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@tailwindcss/typography": "^0.5.15",
    "@types/express": "^5.0.0",
    "@types/node": "^22.9.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.0",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.15",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vite-plugin-singlefile": "^2.0.3",
    "vitest": "^2.1.5"
  }
}
