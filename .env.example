# Every service is optional: whatever isn't configured falls back gracefully
# (offline AI engine, simulated market data, browser-only storage).

# ---- AI (Google Gemini, free tier) ----
# Create a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
EQUIDY_MODEL=gemini-3.6-flash
PORT=8787

# ---- App URL and sessions ----
# Public URL of the app (on Vercel the production domain is detected automatically).
APP_URL=http://localhost:5173
# long random string, e.g. `openssl rand -hex 32`
SESSION_SECRET=

# ---- Database: email accounts and cloud sync (Neon Postgres, free) ----
# On Vercel: Storage → Create Database → Neon sets this automatically. Tables are created on first use.
DATABASE_URL=

# ---- Market data: Alpha Vantage (history, quotes) ----
ALPHAVANTAGE_API_KEY=
# true with a paid key: full history and Alpha Vantage-first quotes
ALPHAVANTAGE_PREMIUM=false

# ---- Financial intelligence: Finnhub (news, ratings, earnings, metrics; also real-time quotes) ----
FINNHUB_API_KEY=

# ---- Sign in with Google / Microsoft / Apple (optional) ----
# Redirect URI to register with each: APP_URL/api/auth/<google|microsoft|apple>/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_TENANT=common
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=
