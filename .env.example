# Every service is optional: whatever isn't configured falls back gracefully
# (offline AI engine, simulated market data, browser-only storage, no bank links).

# ---- AI (OpenAI) ----
OPENAI_API_KEY=
EQUIDY_MODEL=gpt-6.1-sol
PORT=8787

# ---- App URL and sessions ----
# Public URL of the app (on Vercel the production domain is detected automatically).
APP_URL=http://localhost:5173
# long random string, e.g. `openssl rand -hex 32` — required for bank links
SESSION_SECRET=

# ---- Supabase: accounts + database ----
# Project Settings → API. Run supabase/schema.sql once in the SQL Editor.
# In Authentication → URL Configuration, add APP_URL/api/auth/supabase/callback and APP_URL/login
# to the redirect URLs. Turn on Google / Azure (Microsoft) / Apple under Authentication → Providers.
# https://<project>.supabase.co
SUPABASE_URL=
# or SUPABASE_PUBLISHABLE_KEY (sb_publishable_…)
SUPABASE_ANON_KEY=
# or SUPABASE_SECRET_KEY (sb_secret_…) — server only, never expose
SUPABASE_SERVICE_ROLE_KEY=

# ---- Market data: Alpha Vantage (history, quotes) ----
ALPHAVANTAGE_API_KEY=
# true with a paid key: full history and Alpha Vantage-first quotes
ALPHAVANTAGE_PREMIUM=false

# ---- Financial intelligence: Finnhub (news, ratings, earnings, metrics; also real-time quotes) ----
FINNHUB_API_KEY=

# ---- Bank connections: Plaid ----
PLAID_CLIENT_ID=
# the secret for the environment below
PLAID_SECRET=
# sandbox | production
PLAID_ENV=sandbox
# e.g. US,CA,GB,FR,ES,NL,IE
PLAID_COUNTRY_CODES=US
PLAID_PRODUCTS=transactions
# defaults to "investments" in sandbox, none in production
PLAID_OPTIONAL_PRODUCTS=
# needed for OAuth banks (most UK/EU and some US): APP_URL/banking, registered in the Plaid dashboard
PLAID_REDIRECT_URI=
# optional; defaults to a key derived from SESSION_SECRET
TOKEN_ENCRYPTION_KEY=

# ---- Direct OAuth (only used when Supabase isn't configured) ----
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_TENANT=common
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=
