# Optional: enables live Claude responses. Without it, Equidy runs its built-in offline analysis engine.
ANTHROPIC_API_KEY=
EQUIDY_MODEL=claude-opus-5-5
PORT=8787

# ---- Sign-in (each provider is enabled when its variables are set) ----
# Public URL of the app; OAuth redirect URIs are APP_URL/api/auth/<provider>/callback
APP_URL=http://localhost:5173
SESSION_SECRET=            # long random string, e.g. `openssl rand -hex 32`

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

MICROSOFT_TENANT=common    # or your Entra tenant ID
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

APPLE_CLIENT_ID=           # Services ID, e.g. ai.equidy.web
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=         # contents of the .p8 key (\n escapes allowed)
