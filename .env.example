# Every service is optional: whatever isn't configured falls back gracefully
# (offline AI engine, simulated market data, browser-only storage).

# ---- AI (Google Gemini, free tier) ----
# Create a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
EQUIDY_MODEL=gemini-3.6-flash
PORT=8787

# ---- App URL and sessions ----
# Public URL of the app (on Vercel the production domain is detected automatically).
APP_URL=http://localhost:5173
# long random string, e.g. `openssl rand -hex 32`
SESSION_SECRET=

# ---- Database: email accounts and cloud sync (Neon Postgres, free) ----
# On Vercel: Storage → Create Database → Neon sets this automatically. Tables are created on first use.
DATABASE_URL=

# ---- Market data: Alpha Vantage (history, quotes) ----
ALPHAVANTAGE_API_KEY=
# true with a paid key: full history and Alpha Vantage-first quotes
ALPHAVANTAGE_PREMIUM=false

# ---- Financial intelligence: Finnhub (news, ratings, earnings, metrics; also real-time quotes) ----
FINNHUB_API_KEY=

# ---- Error tracking: Sentry (VITE_ values require a redeploy) ----
SENTRY_DSN=
VITE_SENTRY_DSN=

# ---- Shared rate limits and cache: Upstash Redis ----
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ---- Database: Supabase ----
# Put Supabase's transaction pooler connection string in DATABASE_URL above. Optionally add its CA certificate:
DATABASE_CA=

# ---- Sign-in: Clerk (replaces the built-in sign-in when both keys are set) ----
CLERK_SECRET_KEY=
VITE_CLERK_PUBLISHABLE_KEY=

# ---- Usage analytics: PostHog (asks each visitor first) ----
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=https://us.i.posthog.com

# ---- Email: Resend (EMAIL_FROM must use a domain verified in Resend) ----
RESEND_API_KEY=
EMAIL_FROM=Equidy <hello@equidy.website>

# ---- Subscriptions: Stripe (also needs a database) ----
# Webhook URL: APP_URL/api/billing/webhook
# Events: checkout.session.completed, customer.subscription.updated, customer.subscription.deleted
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=

# ---- Semantic news search: Pinecone (index: 768 dimensions, cosine) ----
PINECONE_API_KEY=
PINECONE_INDEX=

# ---- Sign in with Google / Microsoft / Apple (optional) ----
# Redirect URI to register with each: APP_URL/api/auth/<google|microsoft|apple>/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_TENANT=common
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=
